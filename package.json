{
  "name": "deadmans-switch-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./contracts": "./src/contracts.ts",
    "./responses": "./src/responses.ts"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.local/void-runtime.log vite dev",
    "build": "WRANGLER_LOG_PATH=.local/void-build-runtime.log vite build",
    "deploy": "bun run check && void deploy --platform cloudflare --require-email",
    "typecheck": "void prepare && tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "db:generate": "void db generate",
    "db:migrate": "void db migrate",
    "notifications:dev": "bun scripts/notification-gateway.ts",
    "setup:local": "bun scripts/setup-local.ts",
    "test:smoke": "bun scripts/smoke.ts",
    "local": "bun scripts/local-control.ts",
    "test:runtime": "bun scripts/runtime-test.ts",
    "db:migrate:production": "void db migrate --remote",
    "prepare": "void prepare",
    "test:e2e": "bun scripts/e2e.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.10",
    "void": "^1.2.1"
  },
  "packageManager": "bun@1.3.14"
}
