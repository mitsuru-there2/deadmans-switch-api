{
  "name": "deadmans-switch-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./contracts": "./src/contracts.ts",
    "./responses": "./src/responses.ts"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.local/wrangler.log wrangler dev --test-scheduled --ip 127.0.0.1",
    "build": "WRANGLER_LOG_PATH=.local/wrangler.log wrangler deploy --env=\"\" --dry-run --outdir dist",
    "deploy": "bun run check && wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "notifications:dev": "bun scripts/notification-gateway.ts",
    "setup:local": "bun scripts/setup-local.ts",
    "test:smoke": "bun scripts/smoke.ts",
    "local": "bun scripts/local-control.ts",
    "test:runtime": "bun scripts/runtime-test.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@libsql/client": "^0.18.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  },
  "packageManager": "bun@1.3.14"
}
