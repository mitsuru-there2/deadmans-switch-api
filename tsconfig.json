{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["bun", "void/env"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "routes",
    "crons",
    "queues",
    "db",
    "env.ts",
    "vite.config.ts",
    "void.config.ts",
    ".void/**/*.d.ts"
  ]
}
