{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deadmans-switch-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "placement": { "region": "aws:ap-northeast-1" },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false },
  "vars": {
    "APP_ENV": "development",
    "NOTIFICATION_DRIVER": "gateway",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "TRUSTED_ORIGINS": "http://localhost:3000",
    "RECIPIENT_WEB_URL": "http://localhost:3000",
    "TURSO_DATABASE_URL": "http://127.0.0.1:8080",
    "TURSO_LOCATION": "local",
    "NOTIFICATION_GATEWAY_URL": "http://127.0.0.1:8788",
    "DELIVERY_ENABLED": "false",
  },
  "env": {
    "production": {
      "name": "deadmans-switch-api",
      "workers_dev": false,
      "preview_urls": false,
      "placement": { "region": "aws:ap-northeast-1" },
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": false },
      "vars": {
        "APP_ENV": "production",
        "NOTIFICATION_DRIVER": "native",
        "TURSO_LOCATION": "nrt",
        "DELIVERY_ENABLED": "false",
      },
    },
  },
}
